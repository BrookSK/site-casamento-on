# ---- Dependências (futuras) ----
/vendor/
node_modules/

# ---- Ambiente / segredos ----
# (Não usamos .env nesta etapa; ignorado por precaução para o futuro.)
.env
.env.*
*.key
*.pem

# Credenciais do banco de dados (NUNCA versionar).
# O modelo versionado é o database.example.php.
/app/Config/database.php

# Chave de aplicação para cifrar segredos (SMTP, ASAAS). NUNCA versionar.
/app/Config/app_key.php

# ---- Logs e cache ----
*.log
/logs/
/cache/
/tmp/

# ---- Storage de runtime (temporários do mPDF, etc.) ----
# A pasta é mantida no repo via .gitkeep, mas o conteúdo é ignorado.
/storage/mpdf/*
!/storage/mpdf/.gitkeep

# ---- Sistema operacional ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editores / IDEs ----
.vscode/
.idea/
*.swp
*.swo

# ---- Build (futuro) ----
/dist/
/build/
